##17)Get  name list get the subjects name for language subjects ,maths and social only theory marks for science include both theory and practical find the total and perentage of their score rank them based on their marks.


students = []

for i in range(3):
    print("\nStudent", i + 1)

    name = input("Enter name: ")

    tamil = int(input("Enter Tamil mark: "))
    english = int(input("Enter English mark: "))
    maths = int(input("Enter Maths mark: "))
    social = int(input("Enter Social mark: "))

    science_theory = int(input("Enter Science theory mark: "))
    science_practical = int(input("Enter Science practical mark: "))

    total = tamil + english + maths + social + science_theory + science_practical
    percentage = (total / 500) * 100

    students.append([name, total, percentage])

students.sort(key=lambda x: x[1], reverse=True)

print("\n--- Rank List ---")

for rank, student in enumerate(students, 1):
    print("Rank =", rank)
    print("Name =", student[0])
    print("Total =", student[1])
    print("Percentage =", student[2])
